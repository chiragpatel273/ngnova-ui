{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chiragpatel273.github.io/ngnova-ui/schemas/docs-versions.json",
  "title": "NgNova UI documentation versions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "repository",
    "canonicalOrigin",
    "projectPath",
    "defaultVersion",
    "versions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "provider": {
      "const": "github-pages"
    },
    "repository": {
      "type": "string",
      "minLength": 3
    },
    "canonicalOrigin": {
      "type": "string",
      "pattern": "^https://"
    },
    "projectPath": {
      "type": "string",
      "pattern": "^/[a-z0-9-]+$"
    },
    "defaultVersion": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "packageRange", "status", "basePath", "routeMode"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$"
          },
          "packageRange": {
            "type": "string",
            "pattern": "^[1-9][0-9]*\\.x$"
          },
          "status": {
            "enum": ["release-candidate", "stable", "maintenance", "unsupported"]
          },
          "basePath": {
            "type": "string",
            "pattern": "^/[a-z0-9-]+/v[1-9][0-9]*/$"
          },
          "routeMode": {
            "const": "hash"
          }
        }
      }
    }
  }
}
