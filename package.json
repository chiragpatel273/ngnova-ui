{
  "name": "ngnova-ui-workspace",
  "version": "0.0.0",
  "description": "Workspace for NgNova UI, a standalone Angular component library styled with Tailwind CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chiragpatel273/ngnova-ui.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:demo": "npm run build:lib && npm run build:demo:app",
    "build:demo:app": "ng build demo",
    "build:lib": "ng build ui",
    "test:lib": "ng test ui --watch=false",
    "lint:lib": "ng lint ui",
    "lint:demo": "ng lint demo",
    "pack:lib": "npm run build:lib && cd dist/ui && npm pack",
    "publish:lib": "npm run build:lib && cd dist/ui && npm publish --access public",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:package": "node scripts/audit-package.mjs",
    "github:setup-codex-labels": "node scripts/setup-codex-labels.mjs",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cdk": "^22.0.0",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@ng-icons/core": "^34.0.0",
    "@ng-icons/heroicons": "^34.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.0.8"
  }
}
