{
  "name": "ngnova-ui-workspace",
  "version": "0.0.0",
  "description": "Workspace for NgNova UI, a standalone Angular component library styled with Tailwind CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chiragpatel273/ngnova-ui.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:demo": "npm run build:lib && npm run build:demo:app",
    "build:demo:app": "ng build demo",
    "build:docs:versioned": "npm run build:lib && ng build demo --base-href /ngnova-ui/v1/ && node scripts/prepare-versioned-docs.mjs",
    "build:lib": "ng build ui",
    "test:lib": "ng test ui --watch=false",
    "test:demo": "ng test demo --watch=false",
    "lint:lib": "ng lint ui",
    "lint:demo": "ng lint demo",
    "pack:lib": "npm run build:lib && cd dist/ui && npm pack",
    "publish:lib": "npm run build:lib && cd dist/ui && npm publish --access public",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs-api": "node scripts/check-docs-api.mjs",
    "check:focus-contract": "node scripts/check-focus-contract.mjs",
    "check:theme-contract": "node scripts/check-theme-contract.mjs",
    "check:angular-compatibility": "node scripts/check-angular-compatibility.mjs",
    "check:support-matrix": "node scripts/check-support-matrix.mjs",
    "check:visual-manifest": "node scripts/check-visual-manifest.mjs",
    "check:bundle-budgets": "node scripts/check-bundle-budgets.mjs",
    "check:release-docs": "node scripts/check-release-docs.mjs",
    "check:project-policies": "node scripts/check-project-policies.mjs",
    "check:versioned-docs": "node scripts/check-versioned-docs.mjs",
    "check:public-api": "node scripts/check-public-api.mjs",
    "baseline:public-api": "npm run build:lib && node scripts/check-public-api.mjs --write",
    "baseline:bundles": "npm run build:lib && node scripts/check-bundle-budgets.mjs --write",
    "audit:package": "node scripts/audit-package.mjs",
    "github:setup-codex-labels": "node scripts/setup-codex-labels.mjs",
    "smoke:consumer": "node scripts/consumer-matrix.mjs",
    "test:visual": "npm run build:demo && playwright test",
    "test:visual:update": "npm run build:demo && playwright test --update-snapshots",
    "release:check": "node scripts/release-check.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "workspaces": [
    "projects/ui"
  ],
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "22.0.1",
    "@angular/compiler": "22.0.1",
    "@angular/core": "22.0.1",
    "@angular/forms": "22.0.1",
    "@angular/platform-browser": "22.0.1",
    "@angular/router": "22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.1",
    "@angular/cdk": "^22.0.0",
    "@angular/cli": "22.0.1",
    "@angular/compiler-cli": "22.0.1",
    "@angular/platform-server": "22.0.1",
    "@angular/ssr": "22.0.1",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@ng-icons/core": "^34.0.0",
    "@ng-icons/heroicons": "^34.0.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "5.0.3",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "express": "5.1.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.0.8"
  }
}
